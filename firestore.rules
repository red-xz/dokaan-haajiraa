rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Small private shop app — the shop code is the key to access.
    // Any anonymously signed-in user (admin/salesman) can read and
    // write the shop's data. Without knowing the shop code, nobody
    // can find the shop's documents.
    match /shops/{shopCode}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
